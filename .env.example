# Alert levels — 4% is F&O-only (see FO_ONLY_THRESHOLDS); trade still uses 13
# Docs: docs/ALERTS.md · docs/LOGIN.md · docs/ORDERS.md · docs/README.md
THRESHOLD_PCT=4,7,11,13
# Apply these levels only to NSE F&O underlyings (from kite.instruments("NFO"))
FO_ONLY_THRESHOLDS=4

# Tag ASM names in Telegram/console using Zerodha RMS sheet (not a Kite API)
ASM_ENABLED=true
# Optional override; default is Zerodha Utilities consolidated RMS spreadsheet
# ASM_SHEET_URL=

# Liquidity screen via Kite quotes (volume × LTP ≈ turnover)
# Liquidity screen. Turnover is taken from the LAST COMPLETED NSE session
# (bhavcopy), not today's live volume — today's volume is 0 before the
# open, which would empty the universe and stop the watcher starting.
# If the bhavcopy is unavailable it falls back to live volume; watch for
# the "Liquidity screen:" line at startup.
MIN_TURNOVER_CR=25
MIN_PRICE=20

# Feed: mock (no credentials) or kite
FEED_MODE=mock

# Zerodha Kite Connect (required when FEED_MODE=kite)
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# AWS dual-stack: Kite often sees IPv6 even if you whitelisted the Elastic IPv4.
# true = force order API calls over IPv4 (recommended).
KITE_FORCE_IPV4=true

# Telegram Bot API (optional — falls back to console if unset)
TELEGRAM_BOT_TOKEN=
# Destination for alerts. For a group this is a negative id (e.g. -100123…).
# Discover it: stop watch, send a message in the group, then
#   uv run nse-alert telegram-chats
# Group confirms: use /confirm <id> (slash command). BotFather /setprivacy → Disable.
TELEGRAM_CHAT_ID=

# Recommended for live: small fixed list
CUSTOM_UNIVERSE_FILE=universes/liquid_sample.txt

STATE_DIR=.nse_alert

# --- Trading (test run) ---
# BUY only when +13% alert fires; attach SL-Limit (trigger + limit a few ticks below)
TRADE_MODE=off
# Used ONLY when TRADE_SIZING=fixed. Commenting this out does NOT enable 10k
# sizing — keep TRADE_SIZING=margin and TRADE_MARGIN_INR=10000 for that.
TRADE_QTY=1
# margin = size so MIS margin ≈ TRADE_MARGIN_INR (stock leverage from Kite)
# fixed = always use TRADE_QTY shares
TRADE_SIZING=margin
TRADE_MARGIN_INR=10000
# When margins API unavailable (dry_run offline): notional ≈ budget × leverage
TRADE_FALLBACK_LEVERAGE=5
TRADE_PRODUCT=MIS
TRADE_ORDER_TYPE=MARKET
TRADE_MARKET_PROTECTION=2
TRADE_MAX_ORDERS_PER_DAY=10
TRADE_ON_THRESHOLDS=13
TRADE_SIDES=up
TRADE_STOP_LOSS_PCT=2
# Limit price = trigger − N × ₹0.05 (default 2 ticks = ₹0.10)
TRADE_STOP_LIMIT_TICKS=2
# Wait up to N seconds for entry fill before placing SL (live only)
TRADE_STOP_WAIT_SEC=20
# Move SL to entry when LTP is this % above entry (cost-to-cost trail)
TRADE_TRAIL_BREAKEVEN=true
TRADE_TRAIL_BREAKEVEN_PCT=2
# Exit at market the moment LTP hits the upper-circuit band from prev close —
# most NSE mid/small caps circuit at +20%, well above the 11/13% entry level,
# and a resting SL won't fill once the stock locks upper with no sellers left.
TRADE_EXIT_ON_UPPER_CIRCUIT=true
TRADE_UPPER_CIRCUIT_PCT=20
TRADE_CONFIRM_TTL_MINUTES=30
# No fresh MIS entries (auto / confirm / signal offers) after these IST times.
# Zerodha MIS auto square-off since the 3 Aug 2026 closing auction (CAS):
# 15:12 for F&O stocks (continuous trading ends 15:15), 15:25 for the rest.
MIS_CUTOFF_CAS_HHMM=1512
MIS_CUTOFF_NON_CAS_HHMM=1525

# --- Intraday signals: volume spike + 52-week breakout (docs/SIGNALS.md) ---
# Needs FEED_MODE=kite. Volume signals switch the WebSocket to quote mode.
VOLUME_SPIKE_ENABLED=true
# Candle minutes, comma-separated (1,3,5,10,15,30,60) — e.g. 5 or 5,15
VOLUME_SPIKE_TIMEFRAMES=5
VOLUME_SPIKE_EMA_PERIOD=21
# Alert when a closed candle's volume > N × EMA of prior candles' volume
VOLUME_SPIKE_MULT=2
# 09:15 candle carries pre-open volume and is almost always > 2× — skip it
VOLUME_SPIKE_SKIP_OPENING_CANDLE=true
BREAKOUT_52W_ENABLED=true
# Offer /confirm orders on signal alerts (needs TRADE_MODE != off; always
# requires /confirm, even in auto). dry_run → pretend orders.
SIGNAL_ORDERS_ENABLED=true
SIGNAL_ORDER_SIDES=buy,sell

# --- EOD TA screener (separate from intraday alerts / orders) ---
# Run after market close: uv run nse-alert screen
# Cron example (IST): 15 16 * * 1-5  cd /opt/nse-alert && uv run nse-alert screen
SCREEN_MIN_MARKET_CAP_CR=5000
SCREEN_MIN_TURNOVER_CR=10
SCREEN_MIN_PRICE=20
SCREEN_LOOKBACK_DAYS=20
SCREEN_VOLUME_EMA_PERIOD=20
SCREEN_VOLUME_MULT=1.5
SCREEN_SUPERTREND_PERIOD=10
SCREEN_SUPERTREND_MULT=3
SCREEN_EMA_FAST=20
SCREEN_EMA_MID=50
SCREEN_EMA_SLOW=200
SCREEN_ADX_PERIOD=14
SCREEN_ADX_MIN=25
SCREEN_RSI_PERIOD=14
SCREEN_RSI_MIN=40
SCREEN_RSI_MAX=60
SCREEN_MACD_FAST=12
SCREEN_MACD_SLOW=26
SCREEN_MACD_SIGNAL=9
# Within this %% of 52-week high
SCREEN_NEAR_52W_HIGH_PCT=5
# Optional filters (mandatory always: SuperTrend + EMA20>50>200)
SCREEN_REQUIRE_VOLUME=true
SCREEN_REQUIRE_ADX=true
SCREEN_REQUIRE_RSI=true
SCREEN_REQUIRE_MACD=true
SCREEN_REQUIRE_NEAR_52W=true
# On volume-spike days: delivery ≥ this % of traded volume (any spike day passes)
SCREEN_REQUIRE_DELIVERY=true
SCREEN_MIN_DELIVERY_PCT=40
SCREEN_HISTORY_DAYS=400
SCREEN_AFTER_HHMM=1540
# 0 = no limit; set e.g. 30 for a smoke test
SCREEN_MAX_SYMBOLS=0
SCREEN_PREFER_KITE_HISTORY=true
# Optional CSV: symbol,market_cap_cr
# SCREEN_MARKET_CAP_FILE=
# Optional screener-only symbol list (does not reuse CUSTOM_UNIVERSE_FILE)
# SCREEN_CUSTOM_UNIVERSE_FILE=
