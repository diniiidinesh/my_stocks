# Alert levels as % move from previous close (comma-separated for multiple)
# Example: 4,7,11 fires once per level per symbol/direction/day
THRESHOLD_PCT=4,7,11

# Liquidity screen via Kite quotes (volume × LTP ≈ turnover)
MIN_TURNOVER_CR=25
MIN_PRICE=20

# Feed: mock (no credentials) or kite
FEED_MODE=mock

# Zerodha Kite Connect (required when FEED_MODE=kite)
# Paid Connect plan (~₹500/month) is required for live WebSocket market data.
KITE_API_KEY=
KITE_API_SECRET=
# Filled automatically by: uv run nse-alert login
KITE_ACCESS_TOKEN=

# Telegram Bot API (optional — falls back to console if unset)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Recommended for live: small fixed list (avoids quoting thousands of names / Cloudflare)
CUSTOM_UNIVERSE_FILE=universes/liquid_sample.txt

# Where alert dedupe state is stored
STATE_DIR=.nse_alert

# --- Trading (API orders) ---
# off | dry_run | confirm | auto
# Use dry_run on cloud first. auto requires whitelisted static IP (SEBI / Zerodha).
TRADE_MODE=off
TRADE_QTY=1
TRADE_PRODUCT=CNC
TRADE_ORDER_TYPE=MARKET
# Required for algo market orders (Zerodha / exchange rules)
TRADE_MARKET_PROTECTION=2
TRADE_MAX_ORDERS_PER_DAY=5
# Only place when this alert level fires (empty = every THRESHOLD_PCT level)
TRADE_ON_THRESHOLDS=7
# up = BUY on UP only; down = SELL on DOWN; both
TRADE_SIDES=up
TRADE_CONFIRM_TTL_MINUTES=30
