# Alert levels — keep 13 for the test trading strategy (alerts can still list more later)
THRESHOLD_PCT=13

# Liquidity screen via Kite quotes (volume × LTP ≈ turnover)
MIN_TURNOVER_CR=25
MIN_PRICE=20

# Feed: mock (no credentials) or kite
FEED_MODE=mock

# Zerodha Kite Connect (required when FEED_MODE=kite)
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# Telegram Bot API (optional — falls back to console if unset)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Recommended for live: small fixed list
CUSTOM_UNIVERSE_FILE=universes/liquid_sample.txt

STATE_DIR=.nse_alert

# --- Trading (test run) ---
# BUY only when +13% alert fires; attach SL-M at 2% below entry LTP
TRADE_MODE=off
TRADE_QTY=1
TRADE_PRODUCT=CNC
TRADE_ORDER_TYPE=MARKET
TRADE_MARKET_PROTECTION=2
TRADE_MAX_ORDERS_PER_DAY=3
TRADE_ON_THRESHOLDS=13
TRADE_SIDES=up
TRADE_STOP_LOSS_PCT=2
TRADE_CONFIRM_TTL_MINUTES=30
